{
  "name": "genesis-mesh-sdk",
  "version": "0.64.0",
  "description": "TypeScript client for the Genesis Mesh Network Authority API - sovereign trust, attestation, and capability enforcement",
  "type": "module",
  "license": "MIT",
  "author": "Genesis Mesh Labs",
  "homepage": "https://github.com/GenesisMeshLabs/sdk-typescript#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/GenesisMeshLabs/sdk-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/GenesisMeshLabs/sdk-typescript/issues"
  },
  "keywords": [
    "genesis-mesh",
    "trust",
    "attestation",
    "sovereign",
    "network-authority",
    "ed25519",
    "zero-trust",
    "capability"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "check:version": "node scripts/check-version.mjs",
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/finish_cjs.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test:e2e": "node scripts/run_e2e.mjs",
    "test:package": "node scripts/check_package.mjs"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "22.20.4",
    "jest": "30.5.2",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3"
  },
  "overrides": {
    "test-exclude": "8.0.0"
  }
}
