{
  "name": "genesis-mesh-sdk",
  "version": "1.8.1",
  "description": "TypeScript client for the Genesis Mesh Network Authority API: attestations, policy decisions, execution evidence and offline verification",
  "type": "module",
  "license": "MIT",
  "author": "Genesis Mesh Labs",
  "homepage": "https://github.com/GenesisMeshLabs/sdk-typescript#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/GenesisMeshLabs/sdk-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/GenesisMeshLabs/sdk-typescript/issues"
  },
  "keywords": [
    "genesis-mesh",
    "trust",
    "attestation",
    "sovereign",
    "network-authority",
    "ed25519",
    "capability"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "!docs/assets"
  ],
  "scripts": {
    "check:version": "node scripts/check-version.mjs",
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/finish_cjs.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test:e2e": "node scripts/run_e2e.mjs",
    "test:package": "node scripts/check_package.mjs",
    "check:types": "attw --pack .",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local",
    "sync:registry": "node scripts/sync-canonical-registry.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@microsoft/api-extractor": "7.59.4",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.4",
    "fast-check": "4.10.2",
    "jest": "30.5.2",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3"
  },
  "overrides": {
    "test-exclude": "8.0.0"
  }
}
